# Local dev: `cp .env.example .env.local`, paste your keys, run `npm run dev`.
# Production: set the same vars in Vercel/Netlify project settings.
# These are server-side only — they never reach client code, with one marked
# exception: VITE_GOOGLE_CLIENT_ID below is deliberately public (a Google OAuth
# client id is not a secret; it's shown in the sign-in button's own request).

# STT provider selection (PRD §10 / Milestone Zero).
# mock = hardcoded transcript, zero API dependency (default)
STT_PROVIDER=mock            # mock | deepgram | assemblyai | gemini

# Only the key for the selected provider is needed.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Required for the two analysis calls (Tier-B fillers + structure) once live.
GEMINI_API_KEY=

# ————— Access gate: Google sign-in + a lifetime time cap per account —————
# Google Cloud Console → OAuth consent screen (External, published) → Create
# OAuth client ID → Web application. Authorized JavaScript origins must include
# http://localhost:5173 and your production URL. No redirect URI is needed.
GOOGLE_CLIENT_ID=            # server-side audience check
VITE_GOOGLE_CLIENT_ID=       # same value; Vite only exposes VITE_-prefixed vars to the browser

# Signs the session cookie that carries the usage clock. Any long random
# string — treat it like GEMINI_API_KEY and never commit it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Upstash → create a free Redis database → copy the two REST values.
# Stores only { google sub → seconds used }. Without these, sign-in is refused
# rather than letting people in on an allowance nothing is counting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lifetime allowance per Google account, in minutes. Lower it to 1 to test the
# lockout path end to end.
USAGE_LIMIT_MINUTES=30

# Kill-switch. Set to false to disable the whole gate — no login screen, no
# guard on the API endpoints — without a code change or touching Redis.
AUTH_ENABLED=true

# Comma-separated emails that skip the usage cap entirely (operator/admin
# exemption, not a product feature). Leave empty for no exemptions.
ADMIN_EMAILS=

# Spending caps (optional). Paid AI/transcription calls allowed per account for
# its lifetime, and per UTC day for the whole app. Over the cap → a clear
# "used up" / "full for today" message instead of another paid call.
CALLS_PER_ACCOUNT=60
DAILY_CALL_CAP=500
