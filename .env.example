# Local dev: `cp .env.example .env.local`, paste your keys, run `npm run dev`.
# Production: set the same vars in Vercel/Netlify project settings.
# These are server-side only — they never reach client code.

# STT provider selection (PRD §10 / Milestone Zero).
# mock = hardcoded transcript, zero API dependency (default)
STT_PROVIDER=mock            # mock | deepgram | assemblyai | gemini

# Only the key for the selected provider is needed.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Required for the two analysis calls (Tier-B fillers + structure) once live.
GEMINI_API_KEY=
